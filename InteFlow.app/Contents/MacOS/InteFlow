#!/bin/bash
# InteFlow.app — macOS 双击启动入口。
#
# 这个 app 只做三件事：
#   1. 找到项目根目录（正常情况是 InteFlow.app 的上一级）
#   2. 修复从压缩包解压后常见的问题：缺少执行权限、带 quarantine 隔离标记
#   3. 在「终端」里打开 InteFlow.command，日志和 Ctrl-C 都跟手动运行一致
#
# 注意：被 macOS 隔离（quarantine）的 app 首次启动会被「App Translocation」
# 搬到 /private/var/folders/.../AppTranslocation/... 下运行，此时相对路径
# 找不到项目。这里记录了创建时的项目路径作为兜底，并给出明确提示。
set -u

HERE="$(cd "$(dirname "$0")" && pwd)"        # .../InteFlow.app/Contents/MacOS
APP="$(cd "$HERE/../.." && pwd)"              # .../InteFlow.app
ROOT="$(cd "$APP/.." && pwd)"                 # 项目根目录

# 生成 app 时写入的真实项目路径（被 translocation 时仍然可用）
RECORDED="$(cat "$APP/Contents/Resources/root-path.txt" 2>/dev/null || true)"

find_root() {
  local candidate
  for candidate in "$ROOT" "$RECORDED"; do
    if [ -n "$candidate" ] && [ -f "$candidate/InteFlow.command" ]; then
      printf '%s' "$candidate"
      return 0
    fi
  done
  return 1
}

if ! REAL_ROOT="$(find_root)"; then
  cat <<'MSG'
找不到 InteFlow.command。

如果 macOS 把它隔离运行了（路径里出现 AppTranslocation），请先关闭本窗口，
在 InteFlow 项目目录执行一次：

    xattr -dr com.apple.quarantine .

然后重新打开 InteFlow.app。不要把 InteFlow.app 移出项目根目录。
MSG
  osascript -e 'display alert "InteFlow" message "找不到 InteFlow.command。请在项目目录执行 xattr -dr com.apple.quarantine . 后重试（详见终端输出）。" as critical' >/dev/null 2>&1 || true
  exit 1
fi

ROOT="$REAL_ROOT"

# 从压缩包解压时可能丢失可执行位，并带隔离标记。
chmod +x "$ROOT/start.sh" "$ROOT/InteFlow.command" 2>/dev/null || true
xattr -d com.apple.quarantine "$ROOT/start.sh" "$ROOT/InteFlow.command" 2>/dev/null || true

open -a Terminal "$ROOT/InteFlow.command"
